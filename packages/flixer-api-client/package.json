{
	"name": "flixer-api-client",
	"version": "1.1.0",
	"description": "Generated TypeScript client for the Flixer API",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/flixermedia/flixer.git",
		"directory": "packages/flixer-api-client"
	},
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "npm run build && node --test test/*.test.mjs",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"axios": "^1.12.2"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	}
}
