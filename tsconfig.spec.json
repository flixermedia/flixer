{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"rootDir": ".",
		"composite": true,
		"noEmit": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "./dist/types-spec",
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node", "vitest/globals", "vitest/importMeta", "vite/client", "vitest"]
	},
	"include": [
		"src/**/*",
		"src/api/plugins/plugin-manifest.schema.json",
		"src/api/plugins/repository-manifest.schema.json",
		"vitest.config.mts"
	],
	"exclude": ["dist", "coverage", "node_modules"]
}
