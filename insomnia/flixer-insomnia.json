      "description": "Tags: AuthController",
      "method": "DELETE",
      "body": {},
      "parameters": [],
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ _.access_token }}"
        }
      ],
      "afterResponseScript": "const body = insomnia.response.json();\nif (body?.revoked === true && typeof body.id === \"string\" && body.id.length > 0 && body.id === insomnia.environment.get(\"session_id\")) {\n  insomnia.environment.set(\"session_id\", \"\");\n  console.log(\"The current session was revoked; cleared its local credentials.\");\n} else if (body?.revoked !== true || typeof body.id !== \"string\" || body.id.length === 0) {\n  console.warn(\"Revoke response did not confirm success; environment values were not changed.\");\n} else {\n  console.log(\"Another session was revoked; the current environment credentials were kept.\");\n}",
      "authentication": {},
      "metaSortKey": -1792202789039,
      "isPrivate": false,
