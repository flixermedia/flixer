# Optional. The setup wizard configures everything below on first start; anything set here overrides it.
# Bundled Postgres: DATABASE_URL=postgres://flixer:<POSTGRES_PASSWORD>@postgres:5432/flixer
# POSTGRES_PASSWORD=flixer
# REDIS_URL=redis://redis:6379 (the default in Docker)
# PostgreSQL connection and authentication secrets
DATABASE_URL=postgresql://flixer:change-me@database.example:5432/flixer
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Use the same random secret in the API and streamer.
STREAM_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Host-facing URL used in links returned by the API. Include https in production.
FLIXER_PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# Host paths, relative to this repository by default. MEDIA_PATH is the root media folder: admins create libraries
# (Movies, TV Shows, Music...) from folders inside it in the admin dashboard. Natively it may also be a JSON array of paths.
MEDIA_PATH=../flixer-data/media
AVATAR_PATH=../flixer-data/avatars
# Where images uploaded in the admin media editor are stored (Docker host path).
# Outside Docker, set MEDIA_IMAGE_DIR instead (default ./data/media-images).
MEDIA_IMAGE_PATH=../flixer-data/media-images

# SMB shares added in the admin dashboard are mounted under SMB_MOUNT_DIR (Linux/macOS only; Windows uses the \\host\share path).
# With Docker use docker-compose.smb.yml (Linux hosts only), which sets this and SMB_MOUNT_PATH. Saved share passwords are
# encrypted with a key derived from STREAM_TOKEN_SECRET, so changing that secret means re-entering them.
# SMB_MOUNT_DIR=./data/mounts
# Non-root Linux with passwordless sudo and SYS_ADMIN: run mount/umount through sudo.
# SMB_MOUNT_SUDO=true
# SMB_MOUNT_PATH=./mounts

# One SMB share for Docker on Windows, macOS and Linux: docker-compose.smb-volume.yml has Docker mount it for the API,
# streamer and indexer at /smb. Enable it with COMPOSE_FILE=docker-compose.yml:docker-compose.smb-volume.yml
# (separate the files with ; on Windows). Use the server's IP address for SMB_HOST.
# SMB_HOST=192.168.1.10
# SMB_SHARE=media
# SMB_USERNAME=guest
# SMB_PASSWORD=
# SMB_VERSION=3.0
# Extra CIFS mount options, e.g. ro or port=4445.
# SMB_OPTIONS=

# Where flixer keeps its bootstrap configuration (SQLite) and the key that encrypts its secrets. Keep it on a persistent volume.
# Environment variables always override the saved value for their own setting.
# CONFIG_DIR=./data/config

# Passkey configuration must match the address used in the browser.
APP_URL=http://localhost:8080
PASSKEY_RP_ID=localhost
PASSKEY_ORIGINS=http://localhost:8080

# Outbound email (SMTP) is configured in the admin dashboard under General > Email.

# Max simultaneous ffmpeg transcodes; 0 means unlimited.
MAX_TRANSCODES=0
STREAMER_LOG_LEVEL=info

# Native dev only (not for docker compose, which shares this file): write JSON logs here so
# Alloy can ship them to Loki. Used by both flixer and flixer-streamer. See docker-compose.observability.yml.
# LOG_DIR=../flixer-data/logs

# flixer-indexer's internal API (set automatically in docker-compose.yml)
# INDEXER_URL=http://localhost:8092
# Keeps big scans from starving the web UI: at most INDEXER_MAX_WRITES indexer writes hit the database at once,
# up to INDEXER_MAX_QUEUED_WRITES wait, and the rest get a 429 the indexer retries. DATABASE_POOL_MAX is the pool size.
# INDEXER_MAX_WRITES=3
# INDEXER_MAX_QUEUED_WRITES=200
# Keep this at or below your database/pooler's client limit (e.g. Supabase session mode allows 15).
# DATABASE_POOL_MAX=10
